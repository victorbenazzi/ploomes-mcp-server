{
  "name": "ploomes-mcp-server",
  "version": "1.0.0",
  "description": "Unofficial MCP server for Ploomes CRM — connects AI agents to the Ploomes REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ploomes-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ploomes",
    "crm",
    "ai",
    "model-context-protocol",
    "claude",
    "cursor",
    "copilot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorb/ploomes-mcp-server.git"
  },
  "homepage": "https://github.com/victorb/ploomes-mcp-server#readme"
}
